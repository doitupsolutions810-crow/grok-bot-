# Base44 sandbox defaults. Placeholders only — never real credentials.
# Compose loads this FIRST, then /run/base44/app.env (platform secrets) LAST,
# so a dashboard value always overrides anything here.
PORT=3000

# LLM: local Ollama service inside the compose stack
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:3b
MODELS_REQUIRED=qwen2.5:3b,nomic-embed-text
ENABLE_VISION=false
LLM_API_KEY=
OPENAI_COMPAT_URL=

# Native mode: no Docker socket needed. Terminal runs directly in the container,
# browser is a local Chromium, boot only waits for Ollama + the models.
GROK_NATIVE=true
GROK_NATIVE_WORKSPACE=/app/data/native-workspace
GROK_NATIVE_BROWSER_PROFILE=/app/data/browser-profile
GROK_MCP_DATA_DIR=/app/data
AGENTS_FILE=/app/config/agents.json
DATA_DIR=/app/data
OUTPUT_DIR=/output
RUNS_DIR=/app/data/runs

# Boot must prove the stack works before serving traffic
BOOT_STRICT=true

# Governor / orchestration defaults
GROK_GOVERNOR=true
GROK_MAX_PARALLEL=4
GROK_MIN_PARALLEL=1
GROK_THERMAL_MAX_C=80
GROK_SQUAD_N=4
GROK_SQUAD_STEPS=12
GROK_DEEP_ROUNDS=3
GROK_MAX_SPAWN_DEPTH=2

# Auto Review
REVIEW_PATTERNS=
REVIEW_SENSITIVE=false

# Optional integrations (empty = feature stays off)
AVRONE_URL=http://avrone:8710
X_API_BEARER=
X_ACCOUNT=grok_bot
X_POLL_SECONDS=60
XAI_API_KEY=
WHISPER_URL=
PIPER_CMD=
BROWSER_WS=
ALLOWED_TERMINAL_CONTAINERS=grok-sandbox

# Auth gate stays off in the sandbox preview (set via dashboard secrets to enable)
GROK_AUTH_USER=admin
GROK_AUTH_PASSWORD=

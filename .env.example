PORT=3000
# LLM
LLM_PROVIDER=ollama                 # ollama | openai-compat
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:3b                # mistral, qwen2.5:14b, etc.
MODEL_CHAIN=                         # optional fallback chain, e.g. qwen2.5:3b,llama3.2:3b
MODELS_REQUIRED=qwen2.5:3b,nomic-embed-text
ENABLE_VISION=false                  # true → also pulls llava:7b
LLM_API_KEY=
OPENAI_COMPAT_URL=                   # e.g. http://vllm:8000/v1
# Tools
BROWSER_WS=ws://browser:3000
ALLOWED_TERMINAL_CONTAINERS=grok-sandbox
# Governor (Avrone) — health-gated parallelism
GROK_MAX_PARALLEL=4                  # max concurrent workers when the host is healthy
GROK_MIN_PARALLEL=1                  # never below this
GROK_WANT_PARALLEL=                  # hard cap if set (e.g. 2)
GROK_THERMAL_MAX_C=80                # °C where ramp-down starts
GROK_GOVERNOR=true                   # false → full parallelism always
# Orchestration (Trinity)
GROK_SQUAD_N=4                       # default subtask/fallback count
GROK_SQUAD_STEPS=12                  # max tool steps per squad worker
GROK_DEEP_ROUNDS=3                   # max deep review waves
GROK_MAX_SPAWN_DEPTH=2               # subagent tree depth limit
# Auto Review
REVIEW_PATTERNS=                     # custom danger regex for terminal review
REVIEW_SENSITIVE=false               # require review for imagegen/x.search too
# X integration (optional)
X_API_BEARER=
X_ACCOUNT=grok_bot
X_POLL_SECONDS=60
# Optional xAI Grok bridge (if you also own an API key)
XAI_API_KEY=


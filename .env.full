# Grok Bot — FULLY-ENABLED profile (the "final product" configuration).
# Every subsystem on. Copy to .env, then:
#   docker compose --profile full up -d --build
# The full compose profile adds Whisper STT + Piper TTS + ComfyUI imagegen sidecars.

PORT=3000
# --- LLM: benchmarked default + fallback chain ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:3b
MODEL_CHAIN=qwen2.5:3b,llama3.2:3b        # tried in order when a model fails
MODELS_REQUIRED=qwen2.5:3b,nomic-embed-text  # llava:7b is auto-added by ENABLE_VISION=true
ENABLE_VISION=true                         # vision input via LLaVA
LLM_API_KEY=
OPENAI_COMPAT_URL=
# --- Tools ---
BROWSER_WS=ws://browser:3000
ALLOWED_TERMINAL_CONTAINERS=grok-sandbox
# --- Governor (Avrone): health-gated parallelism ---
GROK_MAX_PARALLEL=6                        # more lanes when the host is healthy
GROK_MIN_PARALLEL=1
GROK_WANT_PARALLEL=
GROK_THERMAL_MAX_C=80
GROK_GOVERNOR=true
# --- Orchestration (Trinity): full squad + recursive deep waves ---
GROK_SQUAD_N=4
GROK_SQUAD_STEPS=16
GROK_DEEP_ROUNDS=5                         # max deep review waves (cap)
GROK_MAX_SPAWN_DEPTH=3
# --- Auto Review: require approval for sensitive actions too ---
REVIEW_PATTERNS=
REVIEW_SENSITIVE=true
# --- X integration (fill your listener token) ---
X_API_BEARER=TODO-your-listener-bearer-token
X_ACCOUNT=grok_bot
X_POLL_SECONDS=60
# --- Optional xAI Grok bridge ---
XAI_API_KEY=

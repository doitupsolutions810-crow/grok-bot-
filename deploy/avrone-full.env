# AVRONE — FULLY-ENABLED profile (the "final product" configuration).
# Every shipped feature on: deep squad, fallback chain + breaker, Docker-backed
# sandbox with network, admin terminal, plugins + MCP + search, fleet node,
# skills, self-changes, self-evolution (test-gated), authorized recon.
#
# Usage: cp deploy/full.env .env  →  fill the TODO placeholders  →
#        avrone-cli doctor  →  avrone
# Defaults in .env.example stay lean (Ollama + qwen2.5:3b); this is the maximal profile.

# --- LLM: free open-source route, benchmarked default + fallback chain ---
AVRONE_PROVIDER=ollama
AVRONE_LLM_BASE_URL=http://127.0.0.1:11434/v1
AVRONE_LLM_MODEL=qwen2.5:3b
# Stronger Lead on a GPU host (optional, workers stay on the fast default):
# AVRONE_LEAD_MODEL=qwen3.5:9b
# Gateway fallbacks, tried in order after the primary:
AVRONE_LLM_FALLBACKS=ollama:llama3.2:3b,ollama:qwen3.5:4b
AVRONE_BREAKER_THRESHOLD=3
AVRONE_BREAKER_COOLDOWN=30

# --- Orchestration: full squad + recursive deep waves ---
AVRONE_SQUAD_SIZE=4
AVRONE_DEEP_SQUAD_SIZE=6             # max deep reviewers
AVRONE_MAX_PARALLEL=6
AVRONE_MAX_STEPS=8
AVRONE_MAX_SPAWN_DEPTH=3
AVRONE_LLM_RETRIES=3
AVRONE_LLM_BACKOFF=1.5

# --- Environment: real Docker-backed agent sandbox ---
AVRONE_RUNNER=docker
AVRONE_DOCKER_IMAGE=python:3.12-slim
AVRONE_ALLOW_NETWORK=true
AVRONE_AGENTS_CAN_SHELL=true
AVRONE_WORKSPACE=./workspace
AVRONE_DATA_DIR=./data

# --- Admin terminal (requires a real token) ---
AVRONE_ADMIN_TOKEN=TODO-long-random-token
AVRONE_HOST=127.0.0.1
AVRONE_PORT=8710

# --- Extensions: plugins + MCP + search ---
AVRONE_PLUGINS_DIR=./plugins
AVRONE_MCP_CONFIG=./mcp.json
AVRONE_SEARCH_PROVIDER=auto
# BRAVE_API_KEY=TODO                  # optional, improves search
# TAVILY_API_KEY=TODO

# --- Fleet: link AVRONE servers, agents spawn across nodes ---
AVRONE_FLEET_TOKEN=TODO-long-random-shared-secret
AVRONE_NODE_ID=edge-1
# AVRONE_PUBLIC_URL=https://edge-1.example:8000   # TODO if other nodes should reach you
# AVRONE_FLEET_PARENT=                            # TODO url of your router/root node
# AVRONE_FLEET_ALLOW=edge-1,router                # recommended: non-empty allowlist
AVRONE_FLEET_MAX_HOPS=3
AVRONE_FLEET_HEARTBEAT=15

# --- Agent kit: self-changes + skills ---
AVRONE_SELF_CHANGES=allow
AVRONE_SKILLS_DIR=./skills

# --- Self-evolution: AVRONE may propose edits to its own repo, gated by the full test suite ---
AVRONE_SELF_EVOLVE=allow
AVRONE_REPO_DIR=.
AVRONE_EVOLVE_TEST_CMD=python -m pytest -q

# --- Reconnaissance (bounded, authorized, audited) ---
AVRONE_RECON=allow
AVRONE_RECON_ALLOWLIST=
